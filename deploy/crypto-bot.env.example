# Settings for the bot on the server. setup_server.sh copies this to
# /etc/crypto-bot.env - edit THAT file (nano /etc/crypto-bot.env), not this one.
# After any change: systemctl restart crypto-data_collector crypto-anomaly_detector crypto-decision_agent crypto-execution_engine

EXCHANGE=binance
SYMBOL=BTC/USDT

# Paper trading week: DRY_RUN=true needs NO exchange keys. It reads real
# Binance prices (public data) and places no orders. Leave the keys empty.
# Later, for testnet/live: fill in keys (never enable withdrawals) and set DRY_RUN=false.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Only an exact "false" turns a guard off.
USE_TESTNET=true
DRY_RUN=true

# Paper account for the weekly P/L report
STARTING_BALANCE_USDT=1000
# Binance spot fee per buy/sell, in percent (0.075 if paying fees in BNB)
FEE_PERCENT=0.1

# Strategy (4h won the 2017-2026 backtest)
TIMEFRAME=4h
FAST_WINDOW=10
SLOW_WINDOW=50
TRADE_AMOUNT_USDT=50
STOP_LOSS_PERCENT=2.0
# email both NOTIFY_TO addresses once when the price is this far below the entry
STOP_WARNING_PERCENT=1.5

# Email alerts (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
NOTIFY_TO=humzakhan.karachi@gmail.com,iamanusfromcrypto@gmail.com
